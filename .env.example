# Public API origin/base URL. Leave blank in local dev to auto-target
# http://<current-host>:3000 for private dev hosts.
# Do not include the API prefix here; set VITE_API_PREFIX below.
VITE_API_BASE_URL=

# Public API path prefix mounted by the backend.
VITE_API_PREFIX=/api

VITE_THAID_MODE=disabled

# Google Maps Platform browser key for home visit maps.
# PUBLIC CLIENT CONFIG: this value is visible in the built frontend, so it is
# not a secret. Create a separate Google Cloud API key for the browser:
#   - Enable: Maps JavaScript API
#   - Application restriction: HTTP referrers for localhost/staging/prod only
#   - API restriction: Maps JavaScript API only
# Do not put the backend Geocoding API server key in any VITE_* variable.
VITE_GOOGLE_MAPS_BROWSER_KEY=GOOGLE_MAPS_BROWSER_KEY_PLACEHOLDER
